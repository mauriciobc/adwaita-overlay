#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 mauriciobc
# SPDX-License-Identifier: LGPL-2.1-or-later
# Compile the overlay, install it, and restart style daemons so running
# apps pick it up. GTK reads user CSS at process startup only —
# --gapplication-service daemons (Nautilus, the file picker, …) keep
# painting the old look until killed; they respawn on demand.
#
# Measured 6 Oct 2026 (decisions.md H3): the accent GSettings key IS live in
# a running libadwaita app, but the sheet is not re-read from disk and
# colour-scheme does not switch live either — hence this step rather than a
# "save and it updates" promise.
#
# Usage: tools/build [--debug] [--no-restart]
#
#   --debug  build src/overlay-debug.scss instead — the same sheet plus a
#            1px dotted outline on every node (src/_debug.scss), written to
#            build/gtk-debug.css and installed in its place. Run a plain
#            tools/build to go back to the shipped sheet.
set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
debug=0
restart=1

for arg in "$@"; do
  case "$arg" in
    --debug) debug=1 ;;
    --no-restart) restart=0 ;;
    *)
      echo "usage: $(basename "$0") [--debug] [--no-restart]" >&2
      exit 2
      ;;
  esac
done

if [[ $EUID -eq 0 ]]; then
  echo "error: run as your user, not root (root's XDG config is the wrong target)" >&2
  exit 1
fi

confdir="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0"
src="$repo/src/overlay.scss"
out="$repo/build/gtk.css"
if (( debug )); then
  src="$repo/src/overlay-debug.scss"
  out="$repo/build/gtk-debug.css"
fi

mkdir -p "$repo/build" "$confdir"
sassc "$src" "$out"

target="$confdir/gtk.css"
if [[ -e "$target" && ! -L "$target" ]]; then
  echo "error: refusing to replace a real file: $target" >&2
  echo "       migrate its rules into src/ and remove it first (BACKLOG.md P1.5)" >&2
  exit 1
fi
ln -sfn "$out" "$target"
if (( debug )); then
  echo "installed: $target -> $out ($(wc -l < "$out") lines, DEBUG: every node outlined)"
else
  echo "installed: $target -> $out ($(wc -l < "$out") lines)"
fi

if (( restart )); then
  pids="$(pgrep -f -- '--gapplication-service' || true)"
  if [[ -n "$pids" ]]; then
    # Killing only forces a fresh CSS read; the daemons respawn on demand.
    # shellcheck disable=SC2086
    kill $pids
    echo "restarted $(echo "$pids" | wc -l) --gapplication-service daemon(s)"
  fi
fi
