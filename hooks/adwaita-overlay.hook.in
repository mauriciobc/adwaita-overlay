[Trigger]
Operation = Upgrade
Operation = Install
Type = Package
Target = libadwaita
Target = adwaita-overlay

[Action]
Description = Checking Adwaita overlay selector contract
When = PostTransaction
# Reads the installed libadwaita and the installed sheet: no network, writes
# nothing, safe as root. PostTransaction cannot abort a transaction.
Exec = @CHECKER@ --sheet @SHEET@
